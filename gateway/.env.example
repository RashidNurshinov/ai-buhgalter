# Скопируй в .env и заполни. .env в git НЕ коммитим.
# Токен бота MAX (из настроек бота на бизнес-платформе MAX).
MAX_BOT_TOKEN=

# Необязательно: если MAX отдаёт TLS-сертификат Минцифры РФ, укажи путь
# к CA-бандлу внутри контейнера (смонтируй файл). Проверку TLS не отключаем.
# MAX_CA_BUNDLE=/app/russian_trusted_root_ca.pem

# Хост API можно переопределить (по умолчанию platform-api2.max.ru).
# MAX_API_BASE=https://platform-api2.max.ru

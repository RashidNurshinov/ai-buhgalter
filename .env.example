# ============================================
# AI-Buhgalter — Переменные окружения
# Скопируйте в .env и заполните значения
# ============================================

# === Приложение ===
APP_NAME=AI-Buhgalter
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
APP_DOMAIN=localhost

# === База данных ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_buhgalter
DATABASE_ECHO=false

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Celery ===
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === JWT ===
JWT_SECRET_KEY=change-me-jwt-secret-use-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# === OpenRouter (ИИ) ===
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === Email (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=ИИ-Бухгалтер
SMTP_FROM_EMAIL=noreply@ai-buhgalter.ru

# === Telegram Bot (Этап 3) ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# === Файловое хранилище ===
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=50

# === Интеграции (Этап 2) ===
SBERBANK_API_URL=
SBERBANK_CLIENT_ID=your-sberbank-client-id-here
SBERBANK_CLIENT_SECRET=your-sberbank-secret-here
SBERBANK_SCOPE=/statement /accounts

TINKOFF_API_URL=
TINKOFF_API_TOKEN=your-tinkoff-api-token-here

OFD_API_URL=
OFD_API_KEY=

SFERA_API_URL=
SFERA_API_TOKEN=

SBIS_API_URL=
SBIS_APP_CLIENT_ID=

MOYSKLAD_API_URL=
MOYSKLAD_API_TOKEN=